{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "replicaCount",
    "image",
    "kubernetesComponent",
    "environmentsVars",
    "extraEnvVarsConfigMap",
    "secret",
    "externalSecrets",
    "imagePullSecrets",
    "nameOverride",
    "fullnameOverride",
    "serviceAccount",
    "podAnnotations",
    "podLabels",
    "podSecurityContext",
    "securityContext",
    "containerPorts",
    "publicService",
    "metricsService",
    "gateway",
    "resources",
    "livenessProbe",
    "readinessProbe",
    "autoscaling",
    "terminationGracePeriodSeconds",
    "volumes",
    "volumeMounts",
    "nodeSelector",
    "tolerations",
    "affinity",
    "topologySpreadConstraints",
    "namespace",
    "serviceMonitor"
  ],
  "definitions": {
    "stringMap": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "externalSecretData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secretKey", "remoteRef"],
      "properties": {
        "secretKey": {"type": "string", "minLength": 1},
        "remoteRef": {
          "type": "object",
          "additionalProperties": false,
          "required": ["key"],
          "properties": {
            "key": {"type": "string", "minLength": 1},
            "property": {"type": "string"},
            "version": {"type": "string"},
            "conversionStrategy": {"type": "string"},
            "decodingStrategy": {"type": "string"},
            "metadataPolicy": {"type": "string"}
          }
        }
      }
    }
  },
  "properties": {
    "global": {
      "type": "object",
      "description": "Values shared by a parent chart when GOLFS is used as a dependency.",
      "additionalProperties": true
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "pullPolicy", "tag"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]},
        "tag": {"type": "string"}
      }
    },
    "kubernetesComponent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[A-Za-z0-9]([A-Za-z0-9_.-]*[A-Za-z0-9])?$"
    },
    "environmentsVars": {
      "type": "object",
      "required": [
        "GOLFS_PUBLIC_URL",
        "GOLFS_HTTP_ADDR",
        "GOLFS_ADMIN_ADDR",
        "GOLFS_GITHUB_APP_CLIENT_ID",
        "GOLFS_GITHUB_ALLOWED_INSTALLATION_IDS",
        "GOLFS_S3_ENDPOINT",
        "GOLFS_S3_REGION",
        "GOLFS_S3_BUCKET"
      ],
      "properties": {
        "GOLFS_PUBLIC_URL": {"type": "string", "pattern": "^https://"},
        "GOLFS_HTTP_ADDR": {"type": "string", "minLength": 1},
        "GOLFS_ADMIN_ADDR": {"type": "string", "minLength": 1},
        "GOLFS_GITHUB_APP_CLIENT_ID": {"type": "string", "minLength": 1},
        "GOLFS_GITHUB_ALLOWED_INSTALLATION_IDS": {
          "type": "string",
          "pattern": "^\\s*[1-9][0-9]*\\s*(,\\s*[1-9][0-9]*\\s*)*$"
        },
        "GOLFS_S3_ENDPOINT": {"type": "string", "format": "uri"},
        "GOLFS_S3_REGION": {"type": "string", "minLength": 1},
        "GOLFS_S3_BUCKET": {"type": "string", "minLength": 1}
      },
      "additionalProperties": {
        "type": ["string", "number", "boolean"]
      }
    },
    "extraEnvVarsConfigMap": {"type": "string"},
    "secret": {
      "type": "object",
      "additionalProperties": false,
      "required": ["existingSecret"],
      "properties": {
        "existingSecret": {"type": "string"}
      }
    },
    "externalSecrets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "secretStore", "refreshInterval", "targetSecretName", "secrets"],
      "properties": {
        "enabled": {"type": "boolean"},
        "secretStore": {"type": "string"},
        "refreshInterval": {"type": "string", "minLength": 2},
        "targetSecretName": {"type": "string"},
        "secrets": {
          "type": "array",
          "items": {"$ref": "#/definitions/externalSecretData"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"enabled": {"const": true}},
            "required": ["enabled"]
          },
          "then": {
            "properties": {
              "secretStore": {"minLength": 1},
              "secrets": {
                "minItems": 1,
                "contains": {
                  "type": "object",
                  "properties": {
                    "secretKey": {"const": "GOLFS_GITHUB_APP_PRIVATE_KEY_PEM"}
                  },
                  "required": ["secretKey"]
                }
              }
            }
          }
        }
      ]
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {"type": "string", "minLength": 1}
        }
      }
    },
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "automount", "annotations", "name"],
      "properties": {
        "create": {"type": "boolean"},
        "automount": {"type": "boolean"},
        "annotations": {"$ref": "#/definitions/stringMap"},
        "name": {"type": "string"}
      }
    },
    "podAnnotations": {"$ref": "#/definitions/stringMap"},
    "podLabels": {"$ref": "#/definitions/stringMap"},
    "podSecurityContext": {"type": ["object", "null"]},
    "securityContext": {"type": ["object", "null"]},
    "containerPorts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["http", "metrics"],
      "properties": {
        "http": {"type": "integer", "minimum": 1, "maximum": 65535},
        "metrics": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "publicService": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "port", "annotations"],
      "properties": {
        "type": {"type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "annotations": {"$ref": "#/definitions/stringMap"}
      }
    },
    "metricsService": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "port", "annotations"],
      "properties": {
        "type": {"type": "string", "enum": ["ClusterIP"]},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "annotations": {"$ref": "#/definitions/stringMap"}
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "className", "annotations", "port", "hosts"],
      "properties": {
        "enabled": {"type": "boolean"},
        "className": {"type": "string"},
        "annotations": {"$ref": "#/definitions/stringMap"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["host", "tlsSecretName"],
            "properties": {
              "host": {"type": "string", "minLength": 1},
              "tlsSecretName": {"type": "string", "minLength": 1}
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"enabled": {"const": true}},
            "required": ["enabled"]
          },
          "then": {
            "properties": {
              "className": {"minLength": 1},
              "hosts": {"minItems": 1}
            }
          }
        }
      ]
    },
    "resources": {"type": ["object", "null"]},
    "livenessProbe": {"type": ["object", "null"]},
    "readinessProbe": {"type": ["object", "null"]},
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "minReplicas", "maxReplicas"],
      "properties": {
        "enabled": {"type": "boolean"},
        "minReplicas": {"type": "integer", "minimum": 1},
        "maxReplicas": {"type": "integer", "minimum": 1},
        "targetCPUUtilizationPercentage": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 100
        },
        "targetMemoryUtilizationPercentage": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 100
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"enabled": {"const": true}},
            "required": ["enabled"]
          },
          "then": {
            "anyOf": [
              {
                "properties": {"targetCPUUtilizationPercentage": {"type": "integer"}},
                "required": ["targetCPUUtilizationPercentage"]
              },
              {
                "properties": {"targetMemoryUtilizationPercentage": {"type": "integer"}},
                "required": ["targetMemoryUtilizationPercentage"]
              }
            ]
          }
        }
      ]
    },
    "volumes": {
      "type": "array",
      "items": {"type": "object"}
    },
    "volumeMounts": {
      "type": "array",
      "items": {"type": "object"}
    },
    "nodeSelector": {"$ref": "#/definitions/stringMap"},
    "tolerations": {
      "type": "array",
      "items": {"type": "object"}
    },
    "affinity": {"type": ["object", "null"]},
    "topologySpreadConstraints": {
      "type": "array",
      "items": {"type": "object"}
    },
    "namespace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "labels", "annotations"],
      "properties": {
        "create": {"type": "boolean"},
        "labels": {"$ref": "#/definitions/stringMap"},
        "annotations": {"$ref": "#/definitions/stringMap"}
      }
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 10
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "labels", "interval", "scrapeTimeout"],
      "properties": {
        "enabled": {"type": "boolean"},
        "labels": {"$ref": "#/definitions/stringMap"},
        "interval": {"type": "string", "minLength": 1},
        "scrapeTimeout": {"type": "string", "minLength": 1}
      }
    }
  }
}
